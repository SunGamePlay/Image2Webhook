# n8n webhook (Image2Webhook upload forwarding)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/your-webhook-id

# Shared login (seeded into the users table on startup)
APP_USERNAME=admin
APP_PASSWORD=changeme
APP_SECRET=replace-with-a-long-random-string

# Optional: override SQLite + uploaded images directory (default: ./data)
# On Azure App Service use /home/image2webhook so data survives restarts.
# DATA_DIR=/home/image2webhook

# Set true behind HTTPS (e.g. Azure App Service) so the session cookie is Secure.
# COOKIE_SECURE=true
